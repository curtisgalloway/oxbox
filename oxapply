"""Extract a diff from an ox response and apply it ONLY inside the sandbox.

Refuses absolute paths, parent-directory traversal, and anything that would
land outside the work tree. Never touches a real repository.
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

VERSION = "0.6.0"
HERE = os.path.dirname(os.path.abspath(__file__))
FENCE = re.compile(r"```(?:diff|patch)\s*\n(.*?)```", re.DOTALL)
PATH_LINE = re.compile(r"^(?:---|\+\+\+)\s+(?:[ab]/)?(\S+)", re.MULTILINE)

# ---/+++ lines are not the only place a patch names a target. git also honors
# extended headers, so validating only ---/+++ lets a "rename to ../../x" slip
# past while the operator is reassured with "targets (0)".
EXTRA_HEADER = re.compile(
    r"^(?:diff --git\s+(?P<git>.+)"
    r"|(?:rename|copy)\s+(?:from|to)\s+(?P<move>.+))$",
    re.MULTILINE,
)

# A patch can create a symlink (mode 12xxxx) whose body is an absolute or ../
# target, turning a later in-sandbox write into a write anywhere. Containment
# should not rest on git's internal symlink checks.
SYMLINK_MODE = re.compile(r"^\s*(?:new|old|new file|deleted file)\s+mode\s+12\d{4}\s*$",
                          re.MULTILINE)


def extract(text):
    blocks = FENCE.findall(text)
    if blocks:
        return "\n".join(block.rstrip() for block in blocks) + "\n"
    if text.lstrip().startswith(("--- ", "diff --git")):
        return text
    return None


def candidate_paths(patch):
    """Every path token a patch names, from ---/+++ AND extended headers."""
    found = list(PATH_LINE.findall(patch))
    for match in EXTRA_HEADER.finditer(patch):
        raw = match.group("git") or match.group("move") or ""
        for token in raw.split():
            token = token.strip().strip('"')
            if token.startswith(("a/", "b/")):
                token = token[2:]
            if token:
                found.append(token)
    return found


def unsafe_paths(patch):
    bad = []
    for raw in candidate_paths(patch):
        if raw == "/dev/null":
            continue
        # Textual checks, not Path.is_absolute(): on Windows "/etc/passwd" has a
        # root but no drive and reports False, and a crafted patch could name a
        # drive letter or UNC path outright.
        if raw.startswith(("~", "/", "\\")) or (len(raw) > 1 and raw[1] == ":"):
            bad.append(f"absolute path: {raw}")
        elif ".." in Path(raw).parts or ".." in raw.replace("\\", "/").split("/"):
            bad.append(f"parent traversal: {raw}")
    for match in SYMLINK_MODE.finditer(patch):
        bad.append(f"symlink mode: {match.group(0).strip()}")
    return bad


SKILL_NAME = "ox-review"
# The path the runbook uses to name its own scripts. It is written for a
# checkout, where the skill sits where Claude Code looks for it; --skill
# rewrites it to wherever this tool actually found the skill.
SKILL_PATH_IN_TEXT = ".claude/skills/" + SKILL_NAME


def find_skill():
    """The ox-review runbook, wherever this tool is installed.

    Same two-location rule as oxbox's seatbelt profile: a source checkout
    carries it at .claude/skills/ox-review next to the script, where Claude
    Code finds it on its own; a package installs the script into <prefix>/bin
    and the skill into <prefix>/share/oxbox/ox-review. Code assets anchor at
    the script — only state anchors at the working directory.

    All four tools carry this, the way all four carry VERSION: each is a
    standalone script, so sharing it would mean shipping a module and a
    sys.path to find it on. wiretest asserts the four print the same bytes,
    which is what keeps four copies of one document from drifting.
    """
    candidates = [
        os.path.join(HERE, ".claude", "skills", SKILL_NAME),
        os.path.normpath(os.path.join(HERE, "..", "share", "oxbox", SKILL_NAME)),
    ]
    for directory in candidates:
        if os.path.isfile(os.path.join(directory, "SKILL.md")):
            return directory
    sys.exit("oxapply: the %s skill was not found; looked in:\n" % SKILL_NAME
             + "\n".join("oxapply:   " + path for path in candidates)
             + "\noxapply: a Homebrew install may predate the skill; reinstall or "
               "read it at https://github.com/curtisgalloway/oxbox")


def print_skill():
    """Print the runbook, with the paths this installation actually uses.

    An agent finds this through --help, so the copy it reads has to be
    runnable where it is standing. The text names its scripts by their
    checkout path; an installed tool keeps them under a prefix instead, and a
    runbook whose commands do not exist is worse than no runbook. Provenance
    goes to stderr and the document to stdout, the same split these tools use
    everywhere else, so piping this into a file yields the document alone.
    """
    directory = find_skill()
    path = os.path.join(directory, "SKILL.md")
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    except OSError as error:
        sys.exit("oxapply: cannot read %s: %s" % (path, error))
    sys.stderr.write("oxapply: skill -> %s\n" % path)
    # The document is UTF-8 with LF endings on disk and has to leave that way.
    # Windows' sys.stdout would encode it in the locale codepage instead --
    # cp1252 renders SKILL.md's em dashes as 0x97 -- and translate every \n to
    # \r\n on the way out, so `--skill > runbook.md` there produced a file no
    # UTF-8 reader could open. Same hazard write_lf exists for, one stream over.
    body = text.replace(SKILL_PATH_IN_TEXT, directory).encode("utf-8")
    sys.stdout.flush()
    sys.stdout.buffer.write(body)
    sys.stdout.buffer.flush()


class SkillAction(argparse.Action):
    """Print the skill during parsing, the way --version does.

    --log/--diff are a required group, and argparse enforces that after every
    argument is consumed. A store_true flag checked afterwards would therefore
    never be reached: `oxapply --skill` would be rejected for naming no patch
    source, which is not a question the caller asked. An action fires as its
    flag is consumed, so it answers before the requirement is tested.
    """

    def __init__(self, option_strings, dest, **kwargs):
        super().__init__(option_strings, dest, nargs=0, **kwargs)

    def __call__(self, parser, namespace, values, option_string=None):
        print_skill()
        parser.exit(0)


def main():
    parser = argparse.ArgumentParser(prog="oxapply")
    parser.add_argument("--version", action="version", version="oxapply %s" % VERSION)
    parser.add_argument("--skill", action=SkillAction,
                        help="print the ox-review agent skill — a runbook for "
                             "driving a review from an agent, with the script "
                             "paths this installation actually uses — and exit")
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--log", help="an ox log dir containing content.md")
    source.add_argument("--diff", help="a file containing a raw diff")
    # Working-directory anchored, like oxseed's sandbox: the two must agree
    # on where the sandbox is, and neither can be script-relative once
    # installed to /usr/bin.
    parser.add_argument("--work", default=str(Path.cwd() / "sandbox" / "work"))
    parser.add_argument("--commit", action="store_true",
                        help="commit the applied patch in the sandbox git repo")
    args = parser.parse_args()

    if args.log:
        content_path = Path(args.log) / "content.md"
        if not content_path.is_file():
            sys.exit(f"oxapply: no content.md in {args.log}")
        patch = extract(content_path.read_text(encoding="utf-8"))
        if patch is None:
            sys.exit("oxapply: no diff block found in the response")
    else:
        patch = Path(args.diff).read_text(encoding="utf-8")

    work = Path(args.work).resolve()
    if not work.is_dir():
        sys.exit(f"oxapply: work dir does not exist: {work}")

    # oxbox refuses a --work outside its sandbox because whatever --work names
    # is what gets written to. This file's own docstring makes the same promise
    # -- "Never touches a real repository" -- but nothing enforced it, so a
    # pasted or mistyped path would apply a model-produced patch straight into
    # a real checkout. unsafe_paths below cannot stand in for this: it
    # constrains where a patch may write *relative to* the work dir, and says
    # nothing about where the work dir itself is.
    sandbox_root = (Path.cwd() / "sandbox").resolve()
    if work != sandbox_root and sandbox_root not in work.parents:
        sys.stderr.write(f"oxapply: REFUSING --work {work}\n")
        sys.stderr.write(f"oxapply: it lies outside {sandbox_root}, so applying a\n")
        sys.stderr.write("oxapply: model-produced patch there would touch a real tree.\n")
        sys.stderr.write("oxapply: run ./oxseed first, or name a --work inside the sandbox.\n")
        sys.exit(2)

    if not (work / ".git").exists():
        sys.exit(f"oxapply: {work} is not a git repo (run ./oxseed first)")

    bad = unsafe_paths(patch)
    if bad:
        sys.stderr.write("oxapply: REFUSING - patch targets paths outside the sandbox:\n")
        for item in bad:
            sys.stderr.write(f"  {item}\n")
        sys.exit(2)

    # Unique per run: --check and --apply are separate git invocations that each
    # re-read this file, so a fixed name lets a concurrent run swap in a patch
    # that was never the one validated.
    handle, temp_name = tempfile.mkstemp(prefix="pending-", suffix=".patch",
                                         dir=str(work.parent))
    # newline="" is load-bearing on Windows. Python's text mode translates \n
    # to \r\n there, so the patch would be written with CRLF endings and then
    # compared against an LF working tree -- git rejects it with a "does not
    # apply" that looks like a malformed diff and is not. Same patch, same
    # bytes, applies by hand.
    with os.fdopen(handle, "w", encoding="utf-8", newline="") as stream:
        stream.write(patch)
    patch_path = Path(temp_name)

    try:
        targets = sorted(set(candidate_paths(patch)) - {"/dev/null"})
        sys.stderr.write(f"oxapply: patch -> {patch_path}\n")
        sys.stderr.write(f"oxapply: targets ({len(targets)}): {', '.join(targets)}\n")

        strategies = [
            ("strict", []),
            ("recount", ["--recount"]),
            ("recount+C1", ["--recount", "-C1"]),
        ]

        chosen = None
        last_error = ""
        for name, flags in strategies:
            check = subprocess.run(
                ["git", "-C", str(work), "apply", "--check", *flags, str(patch_path)],
                capture_output=True, text=True,
            )
            if check.returncode == 0:
                chosen = (name, flags)
                break
            last_error = check.stderr

        if chosen is None:
            sys.stderr.write("oxapply: patch does not apply at any strictness level:\n")
            sys.stderr.write(last_error)
            sys.exit(3)

        name, flags = chosen
        if name != "strict":
            sys.stderr.write(
                f"oxapply: WARNING - patch only applied with '{name}'. The model emitted a\n"
                f"oxapply: malformed hunk (usually wrong line counts or missing trailing\n"
                f"oxapply: context). Re-read the resulting diff carefully.\n"
            )

        applied = subprocess.run(
            ["git", "-C", str(work), "apply", "--stat", "--apply", *flags, str(patch_path)],
            capture_output=True, text=True,
        )
        sys.stdout.write(applied.stdout)
        if applied.returncode != 0:
            sys.stderr.write(applied.stderr)
            sys.exit(3)

        if args.commit:
            subprocess.run(["git", "-C", str(work), "add", "-A"], check=True)
            subprocess.run(
                ["git", "-C", str(work), "-c", "user.email=ox@sandbox.invalid",
                 "-c", "user.name=ox-alpha", "commit", "-q", "-m", "ox patch"],
                check=True,
            )

        sys.stderr.write("oxapply: applied inside sandbox only\n")
        sys.stderr.write(f"oxapply: review with: git -C {work} diff HEAD\n")
    finally:
        # mkstemp leaves the file behind on every exit path -- success, a
        # refused patch, a patch that would not apply. They accumulated in
        # sandbox/ until the next --clean; the live repo had 15 of them when
        # this was found. They hold the model's raw output, so they are worth
        # removing rather than leaving for an archive to pick up.
        try:
            patch_path.unlink()
        except OSError as error:
            sys.stderr.write(f"oxapply: could not remove {patch_path}: {error}\n")



if __name__ == "__main__":
    main()

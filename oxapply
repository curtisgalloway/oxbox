"""Extract a diff from an ox response and apply it ONLY inside the sandbox.

Refuses absolute paths, parent-directory traversal, and anything that would
land outside the work tree. Never touches a real repository.
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

VERSION = "0.1.0"
HERE = Path(__file__).resolve().parent
FENCE = re.compile(r"```(?:diff|patch)\s*\n(.*?)```", re.DOTALL)
PATH_LINE = re.compile(r"^(?:---|\+\+\+)\s+(?:[ab]/)?(\S+)", re.MULTILINE)

# ---/+++ lines are not the only place a patch names a target. git also honors
# extended headers, so validating only ---/+++ lets a "rename to ../../x" slip
# past while the operator is reassured with "targets (0)".
EXTRA_HEADER = re.compile(
    r"^(?:diff --git\s+(?P<git>.+)"
    r"|(?:rename|copy)\s+(?:from|to)\s+(?P<move>.+))$",
    re.MULTILINE,
)

# A patch can create a symlink (mode 12xxxx) whose body is an absolute or ../
# target, turning a later in-sandbox write into a write anywhere. Containment
# should not rest on git's internal symlink checks.
SYMLINK_MODE = re.compile(r"^\s*(?:new|old|new file|deleted file)\s+mode\s+12\d{4}\s*$",
                          re.MULTILINE)


def extract(text):
    blocks = FENCE.findall(text)
    if blocks:
        return "\n".join(block.rstrip() for block in blocks) + "\n"
    if text.lstrip().startswith(("--- ", "diff --git")):
        return text
    return None


def candidate_paths(patch):
    """Every path token a patch names, from ---/+++ AND extended headers."""
    found = list(PATH_LINE.findall(patch))
    for match in EXTRA_HEADER.finditer(patch):
        raw = match.group("git") or match.group("move") or ""
        for token in raw.split():
            token = token.strip().strip('"')
            if token.startswith(("a/", "b/")):
                token = token[2:]
            if token:
                found.append(token)
    return found


def unsafe_paths(patch):
    bad = []
    for raw in candidate_paths(patch):
        if raw == "/dev/null":
            continue
        # Textual checks, not Path.is_absolute(): on Windows "/etc/passwd" has a
        # root but no drive and reports False, and a crafted patch could name a
        # drive letter or UNC path outright.
        if raw.startswith(("~", "/", "\\")) or (len(raw) > 1 and raw[1] == ":"):
            bad.append(f"absolute path: {raw}")
        elif ".." in Path(raw).parts or ".." in raw.replace("\\", "/").split("/"):
            bad.append(f"parent traversal: {raw}")
    for match in SYMLINK_MODE.finditer(patch):
        bad.append(f"symlink mode: {match.group(0).strip()}")
    return bad


def main():
    parser = argparse.ArgumentParser(prog="oxapply")
    parser.add_argument("--version", action="version", version="oxapply %s" % VERSION)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--log", help="an ox log dir containing content.md")
    source.add_argument("--diff", help="a file containing a raw diff")
    parser.add_argument("--work", default=str(HERE / "sandbox" / "work"))
    parser.add_argument("--commit", action="store_true",
                        help="commit the applied patch in the sandbox git repo")
    args = parser.parse_args()

    if args.log:
        content_path = Path(args.log) / "content.md"
        if not content_path.is_file():
            sys.exit(f"oxapply: no content.md in {args.log}")
        patch = extract(content_path.read_text(encoding="utf-8"))
        if patch is None:
            sys.exit("oxapply: no diff block found in the response")
    else:
        patch = Path(args.diff).read_text(encoding="utf-8")

    work = Path(args.work).resolve()
    if not work.is_dir():
        sys.exit(f"oxapply: work dir does not exist: {work}")
    if not (work / ".git").exists():
        sys.exit(f"oxapply: {work} is not a git repo (run ./oxseed first)")

    bad = unsafe_paths(patch)
    if bad:
        sys.stderr.write("oxapply: REFUSING - patch targets paths outside the sandbox:\n")
        for item in bad:
            sys.stderr.write(f"  {item}\n")
        sys.exit(2)

    # Unique per run: --check and --apply are separate git invocations that each
    # re-read this file, so a fixed name lets a concurrent run swap in a patch
    # that was never the one validated.
    handle, temp_name = tempfile.mkstemp(prefix="pending-", suffix=".patch",
                                         dir=str(work.parent))
    # newline="" is load-bearing on Windows. Python's text mode translates \n
    # to \r\n there, so the patch would be written with CRLF endings and then
    # compared against an LF working tree -- git rejects it with a "does not
    # apply" that looks like a malformed diff and is not. Same patch, same
    # bytes, applies by hand.
    with os.fdopen(handle, "w", encoding="utf-8", newline="") as stream:
        stream.write(patch)
    patch_path = Path(temp_name)

    targets = sorted(set(candidate_paths(patch)) - {"/dev/null"})
    sys.stderr.write(f"oxapply: patch -> {patch_path}\n")
    sys.stderr.write(f"oxapply: targets ({len(targets)}): {', '.join(targets)}\n")

    strategies = [
        ("strict", []),
        ("recount", ["--recount"]),
        ("recount+C1", ["--recount", "-C1"]),
    ]

    chosen = None
    last_error = ""
    for name, flags in strategies:
        check = subprocess.run(
            ["git", "-C", str(work), "apply", "--check", *flags, str(patch_path)],
            capture_output=True, text=True,
        )
        if check.returncode == 0:
            chosen = (name, flags)
            break
        last_error = check.stderr

    if chosen is None:
        sys.stderr.write("oxapply: patch does not apply at any strictness level:\n")
        sys.stderr.write(last_error)
        sys.exit(3)

    name, flags = chosen
    if name != "strict":
        sys.stderr.write(
            f"oxapply: WARNING - patch only applied with '{name}'. The model emitted a\n"
            f"oxapply: malformed hunk (usually wrong line counts or missing trailing\n"
            f"oxapply: context). Re-read the resulting diff carefully.\n"
        )

    applied = subprocess.run(
        ["git", "-C", str(work), "apply", "--stat", "--apply", *flags, str(patch_path)],
        capture_output=True, text=True,
    )
    sys.stdout.write(applied.stdout)
    if applied.returncode != 0:
        sys.stderr.write(applied.stderr)
        sys.exit(3)

    if args.commit:
        subprocess.run(["git", "-C", str(work), "add", "-A"], check=True)
        subprocess.run(
            ["git", "-C", str(work), "-c", "user.email=ox@sandbox.invalid",
             "-c", "user.name=ox-alpha", "commit", "-q", "-m", "ox patch"],
            check=True,
        )

    sys.stderr.write("oxapply: applied inside sandbox only\n")
    sys.stderr.write(f"oxapply: review with: git -C {work} diff HEAD\n")


if __name__ == "__main__":
    main()

#!/bin/bash
# SPDX-FileCopyrightText: 2026 Curtis Galloway
# SPDX-License-Identifier: Apache-2.0
#
# Run a command inside the seatbelt jail: no network, no writes outside the
# sandbox work directory, no reads of the user's home outside it.
#
# Usage: ./oxbox [--work DIR] -- command args...

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK="$HERE/sandbox/work"
PROFILE="$HERE/profiles/jail.sb"
REAL_HOME="$HOME"

ALLOW_EXTERNAL_OUTPUT=0

while [ $# -gt 0 ]; do
  case "$1" in
    --work) WORK="$2"; shift 2 ;;
    --allow-external-output) ALLOW_EXTERNAL_OUTPUT=1; shift ;;
    --) shift; break ;;
    *) printf 'oxbox: unexpected argument: %s\n' "$1" >&2; exit 64 ;;
  esac
done

if [ $# -eq 0 ]; then
  printf 'oxbox: no command given (use: ./oxbox -- pytest -q)\n' >&2
  exit 64
fi

if [ ! -d "$WORK" ]; then
  printf 'oxbox: work dir does not exist: %s\n' "$WORK" >&2
  exit 66
fi

WORK="$(cd "$WORK" && pwd -P)"
SANDBOX_ROOT="$(cd "$HERE" && pwd -P)/sandbox"

case "$WORK/" in
  "$SANDBOX_ROOT"/*) ;;
  *)
    printf 'oxbox: REFUSING --work %s\n' "$WORK" >&2
    printf 'oxbox: the profile grants write access to whatever --work names, so a\n' >&2
    printf 'oxbox: work dir outside %s is not a jail at all.\n' "$SANDBOX_ROOT" >&2
    exit 78
    ;;
esac

mkdir -p "$WORK/.oxtmp"

# Seatbelt gates open(), not writes to a descriptor the shell already opened.
# `oxbox -- cmd > ~/notes.md` therefore hands jailed code a live handle to a
# file outside the sandbox. Refuse rather than quietly make the headline
# guarantee false; --allow-external-output opts out deliberately.
FD_REPORT="$(mktemp -t oxbox-fdguard)"
FD_STATUS=0
python3 "$HERE/fdguard.py" "$SANDBOX_ROOT" "$FD_REPORT" || FD_STATUS=$?

if [ "$FD_STATUS" -eq 3 ] && [ "$ALLOW_EXTERNAL_OUTPUT" -eq 0 ]; then
  printf 'oxbox: REFUSING - output is redirected outside the sandbox:\n' >&2
  while IFS= read -r line; do
    [ -n "$line" ] && printf 'oxbox:   %s\n' "$line" >&2
  done < "$FD_REPORT"
  printf 'oxbox: the shell opened that file before the jail existed, so jailed\n' >&2
  printf 'oxbox: code can write whatever it likes through the inherited handle.\n' >&2
  printf 'oxbox: redirect inside %s, or pass --allow-external-output.\n' "$WORK" >&2
  rm -f "$FD_REPORT"
  exit 78
fi

if [ "$FD_STATUS" -eq 3 ]; then
  printf 'oxbox: WARNING - output redirected outside the sandbox (allowed):\n' >&2
  while IFS= read -r line; do
    [ -n "$line" ] && printf 'oxbox:   %s\n' "$line" >&2
  done < "$FD_REPORT"
fi

rm -f "$FD_REPORT"

# Existence of sensitive paths must be decided OUT here. Inside the jail even
# stat() is denied, so a probe that tests existence itself would report "absent"
# for a path that is merely well hidden -- a test that silently stops testing.
EXISTING_PATHS=""
for candidate in \
  "$REAL_HOME/.ssh" \
  "$REAL_HOME/.aws" \
  "$REAL_HOME/.claude" \
  "$REAL_HOME/.zsh_history" \
  "$REAL_HOME/Library/Keychains" \
  "$HERE/.env"
do
  if [ -e "$candidate" ]; then
    EXISTING_PATHS="${EXISTING_PATHS}${candidate}
"
  fi
done

printf 'oxbox: jail=%s work=%s\n' "$PROFILE" "$WORK" >&2
printf 'oxbox: network=DENIED writes=%s only\n' "$WORK" >&2
printf 'oxbox: env=CLEARED (nothing from the parent shell crosses in)\n' >&2

cd "$WORK"

exec sandbox-exec -f "$PROFILE" -D "WORK=$WORK" \
  /usr/bin/env -i \
    HOME="$WORK" \
    REAL_HOME="$REAL_HOME" \
    REPO_ROOT="$HERE" \
    OXBOX_EXISTING_PATHS="$EXISTING_PATHS" \
    TMPDIR="$WORK/.oxtmp" \
    PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    TERM="${TERM:-dumb}" \
    LANG="${LANG:-en_US.UTF-8}" \
    PYTHONDONTWRITEBYTECODE=1 \
    "$@"
